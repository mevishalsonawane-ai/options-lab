<?xml version="1.0" encoding="utf-8"?>
<!-- JarvisAlgo home-screen widget: Jarvis's last word, and a trade waiting for Boss's answer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/j_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/j_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS"
        android:letterSpacing="0.2"
        android:textColor="#4AA8FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/j_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="5"
        android:ellipsize="end"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/j_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/j_approve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Approve"
            android:textColor="@color/widget_gain"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/j_reject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Reject"
            android:textColor="@color/widget_loss"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/j_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_soft"
        android:textSize="11sp" />
</LinearLayout>
