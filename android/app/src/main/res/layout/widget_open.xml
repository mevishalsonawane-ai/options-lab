<?xml version="1.0" encoding="utf-8"?>
<!-- The "Open" home-screen widget: today's P&L on top, then only open positions and pending orders. It only draws.
     Every account figure starts hidden; until the owner allows it, only the note asking to turn it on shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ow_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/ow_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_widget_title"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ow_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_soft"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ow_pnl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ow_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_soft"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ow_stamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_soft"
        android:textSize="10sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ow_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/widget_rule"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ow_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/open_widget_off"
        android:textColor="@color/widget_soft"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/ow_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ow_t0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
