<?xml version="1.0" encoding="utf-8"?>
<!-- The "Open" widget: redrawn only when the live watch or the app already has the books, never on a timer of its own.
     Home screen only: no account figure on a locked phone. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_open"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/open_widget_description" />
